{
  "expo": {
    "name": "frontend-new",
    "slug": "frontend-new",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow E-Joutia to access your location to show nearby listings."
        }
      ]
    ]
  }
}
